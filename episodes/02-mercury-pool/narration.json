  "text": "You can't drown in this pool.",
  "file": "vo/line1.wav",
  "dur": 1.296,
  "sr": 24000
 },
 {
  "i": 2,
  "text": "It's mercury, over thirteen times heavier than water.",
  "file": "vo/line2.wav",
  "dur": 2.862,
  "sr": 24000
 },
 {
  "i": 3,
  "text": "Dive in and you bounce.",
  "file": "vo/line3.wav",
  "dur": 1.182,
  "sr": 24000
 },
 {
  "i": 4,
  "text": "Lie down: only seven percent of you sinks.",
