  "dur": 2.151,
  "sr": 24000
 },
 {
  "i": 6,
  "text": "The real danger?",
  "file": "vo/line6.wav",
  "dur": 0.964,
  "sr": 24000
 },
 {
  "i": 7,
  "text": "The air above it: hundreds of times the safe limit.",
